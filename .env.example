APP_NAME=TaskR
APP_ENV=local
# Generate with: openssl rand -base64 32
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# Public deployment checklist: APP_ENV=production, APP_DEBUG=false, APP_URL set
# to the public URL (docker-compose.yml interpolates it), and a strong
# DB_PASSWORD before the first boot.

# Docker image tag deployed by docker-compose.yml. GHCR tags carry no "v"
# (git tag v1.2.0 → image 1.2.0). "latest" tracks every stable release; pin
# a version (e.g. 1.2.0) in production so upgrades are explicit.
TASKR_VERSION=latest

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database — three supported setups:
#
# 1. Docker with the bundled postgres (default): keep DB_HOST/DB_PORT
#    commented and COMPOSE_PROFILES=bundled-db enabled below — compose wires
#    the internal service automatically.
# 2. Local dev without docker (composer dev): uncomment DB_HOST/DB_PORT below
#    (the bundled postgres publishes 5433 on the loopback).
# 3. Docker with an external/managed database: comment out COMPOSE_PROFILES
#    and set DB_HOST/DB_PORT/DB_USERNAME/DB_PASSWORD (or DB_URL). Requires
#    PostgreSQL with the pgvector extension — run
#    `CREATE EXTENSION IF NOT EXISTS vector;` on the target database before
#    the first boot. TLS: DB_SSLMODE=require (default: prefer), or append
#    ?sslmode=require to DB_URL.
# ---------------------------------------------------------------------------

# COMPOSE_PROFILES=bundled-db

DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5433
DB_DATABASE=taskr
DB_USERNAME=postgres
# Seeds the bundled postgres container on first boot only — the data volume
# keeps these credentials afterwards. For an external database, they are the
# app's connection credentials.
DB_PASSWORD=root
# External database in one line (overrides host/port/credentials above):
# DB_URL=postgres://user:password@host:5432/taskr?sslmode=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Knowledge base semantic search (any OpenAI-compatible embeddings endpoint,
# e.g. Mistral: https://api.mistral.ai/v1 with model mistral-embed, 1024 dims).
# Production runs on PostgreSQL and requires the pgvector extension.
KNOWLEDGE_EMBEDDINGS_BASE_URL=https://api.mistral.ai/v1
KNOWLEDGE_EMBEDDINGS_API_KEY=
KNOWLEDGE_EMBEDDINGS_MODEL=mistral-embed
