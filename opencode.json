{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "servers": {
            "laravel-boost": {
                "type": "local",
                "command": ["php", "artisan", "boost:mcp"]
            },
            "taskr": {
                "type": "remote",
                "url": "http://localhost:8000/mcp",
                "oauth": false,
                "headers": {
                    "Authorization": "Bearer {env:TASKR_MCP_TOKEN}"
                }
            }
        }
    }
}
