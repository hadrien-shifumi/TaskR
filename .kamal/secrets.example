# Copy to .kamal/secrets (gitignored) and fill in the values.
# These are read by Kamal for ERB interpolation and injected as secret env vars.

# A Scaleway API secret key allowed to push/pull the registry namespace.
KAMAL_REGISTRY_PASSWORD=

# Comma-separated list of web/worker server IPs.
KAMAL_WEB_HOSTS=203.0.113.10

# Public domain the proxy will serve (must point at the server IP).
KAMAL_PROXY_HOST=taskr.example.com

# Target architecture: amd64 or arm64 (Scaleway PRO2-XXS = amd64, PLAY2-PICO = arm64).
KAMAL_ARCH=amd64

# Scaleway managed PostgreSQL.
KAMAL_DB_HOST=taskr-db.example.nodes.scw.cloud
KAMAL_DB_PORT=5432

# Application secrets (injected into containers as env vars).
APP_KEY=
DB_PASSWORD=
KNOWLEDGE_EMBEDDINGS_API_KEY=
